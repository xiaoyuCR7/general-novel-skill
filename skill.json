{
  "name": "general-novel-skill",
  "version": "8.2.0",
  "description": "面向中文小说创作的可恢复创作系统（长篇 + 短篇）：以轻量意图路由、章意图契约、场景渲染内核和原子追踪事务协调开书、续写、修订、分析与发布。支持34题材、多平台适配。",
  "activation": {
    "patterns": [
      "/general-novel-skill",
      "/开书",
      "/写小说",
      "/网文"
    ],
    "triggers": [
      "用户要开书、做题材定位或长篇规划",
      "用户要写总纲、卷纲或章纲，或补纲改纲",
      "用户要写第X章、续写或日更",
      "用户要写短篇或短篇结尾句",
      "用户要去AI味、润色或修订章节",
      "用户要导入旧稿并接手续写",
      "用户要拆文或仿写",
      "用户要扫榜或做市场与资料调研",
      "用户要选投稿平台，或准备简介、标签、封面等上架物料",
      "用户要追踪人物状态、伏笔或时间线",
      "用户提到卡文、人设崩了、爽点或节奏失控",
      "用户要校准文风或检查字数与质量评分",
      "用户提到敏感词、脱敏或地名代称",
      "用户提到章节衔接、脱节或连贯性",
      "用户要在中断后恢复写作进度"
    ]
  },
  "compatibility": {
    "requires": [
      "Python 3.8+",
      "文件系统读写权限"
    ],
    "supported_tools": [
      "claude-code",
      "trae",
      "cursor",
      "opencode",
      "codex",
      "gemini-cli",
      "antigravity",
      "mcp-client"
    ],
    "installer": {
      "bash": "install.sh",
      "powershell": "install.ps1"
    }
  },
  "mcp_server": {
    "enabled": true,
    "entry": "mcp_server/server.py",
    "transport": "stdio",
    "tools_count": 24
  },
  "metadata": {
    "author": "熊小雨",
    "license": "MIT",
    "homepage": "https://github.com/xiaoyuCR7/general-novel-skill",
    "repository": "https://github.com/xiaoyuCR7/general-novel-skill",
    "created": "2026-07-26",
    "last_reviewed": "2026-10-12",
    "review_interval_days": 90,
    "genre_cards_count": 34,
    "scripts_count": 47,
    "tests_count": 1249,
    "craft_files_count": 50,
    "workflow_files_count": 31,
    "reference_files_count": 121
  },
  "features": {
    "core_contracts": [
      "lightweight_intent_router",
      "chapter_intent_contract",
      "scene_rendering_kernel",
      "skill_contract_audit"
    ],
    "writing_workflows": [
      "开书初始化",
      "三级大纲（总纲/卷纲/章纲）",
      "单章写作循环",
      "Beat Sheet多步流水线",
      "日更批量模式",
      "全自动写书调度",
      "短篇五段式"
    ],
    "quality_assurance": [
      "7 Gate去AI腔",
      "节奏三档制与A/B/C配额",
      "语义级节奏审查",
      "七维启发式文本统计（不代表语义审核）",
      "门禁修复计划",
      "正文显式约束与场景可信度审计",
      "恢复后文学复审",
      "限时行动时间可感知性审计"
    ],
    "long_form_support": [
      "百万字结构展开",
      "大纲锚点配额",
      "知识图谱",
      "RAG检索增强",
      "上下文管理",
      "伏笔台账追踪"
    ],
    "craft_depth": [
      "读者契约深度理论",
      "情绪弧线操作手册",
      "叙事元素卡",
      "结构技法卡",
      "情绪模块公式",
      "智斗构型法",
      "升级循环法",
      "多角度强化",
      "改编法",
      "三重重复检测",
      "章节衔接工艺（章间因果链/四类过渡元素/动机连贯/呼应预示/割裂诊断）"
    ],
    "cross_platform": [
      "Claude Code",
      "TRAE",
      "Cursor",
      "OpenCode",
      "Codex",
      "任何MCP客户端"
    ]
  }
}
